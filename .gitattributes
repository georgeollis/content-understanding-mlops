*.pdf filter=lfs diff=lfs merge=lfs -text

# analyzers/README.md is generated with LF-only line breaks by schemas/list-families.ps1.
# Force it to always check out as LF so ci-check.ps1's "is the index stale" regeneration
# check produces identical bytes regardless of the checking-out machine/runner's
# core.autocrlf setting (this must be scoped narrowly - a blanket "* text=auto" here also
# renormalizes golden-set .pdf/.expected.json files, which breaks their manifest checksums).
analyzers/README.md text eol=lf
